{
  "name": "cyberfusion-backend",
  "version": "0.2.0",
  "description": "CyberFusion backend API — threat intelligence correlation and alert prioritisation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit --testPathPattern=unit",
    "test:integration": "jest --runInBand --forceExit --testPathPattern=integration",
    "verify:intelligence": "node src/scripts/verifyIntelligencePipeline.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "groq-sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.43.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
