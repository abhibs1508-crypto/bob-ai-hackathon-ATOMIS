# =============================================================================
# CyberFusion — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is already in .gitignore.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cyberfusion_db
DB_USER=root
DB_PASSWORD=

# ── Backend Server ────────────────────────────────────────────────────────────
BACKEND_PORT=4000
NODE_ENV=development

# ── AI Service (provider-agnostic; configure one block below) ─────────────────
# Supported values for AI_PROVIDER: watsonx | openai | mock | groq
AI_PROVIDER=watsonx

# IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# OpenAI (alternative — only used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o


AI_PROVIDER=groq

# Add the real value only in your uncommitted .env file.
GROQ_API_KEY=your_groq_api_key_here

GROQ_MODEL=openai/gpt-oss-120b

GROQ_TIMEOUT_MS=30000
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.2
# ── Frontend (Vite build-time variables only — NO secrets here) ────────────────
# These are injected at build time and are visible in the browser bundle.
VITE_API_BASE_URL=http://localhost:4000/api

# ── Risk Engine Weights (optional overrides — defaults are in risk.config.js) ──
# RISK_WEIGHT_SEVERITY=30
# RISK_WEIGHT_IOC_MATCH=25
# RISK_WEIGHT_ASSET_CRITICALITY=20
# RISK_WEIGHT_CORRELATION_STRENGTH=15
# RISK_WEIGHT_RECENCY=10
